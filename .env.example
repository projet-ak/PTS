# --- PostgreSQL (docker compose) ---
POSTGRES_USER=pts
POSTGRES_PASSWORD=guclu-bir-parola-yaz
POSTGRES_DB=pts

# Backend'i Docker disinda (cargo run) calistirirken kullanilan baglanti.
# Compose icinde bu deger DATABASE_URL olarak otomatik uretilir.
DATABASE_URL=postgres://pts:guclu-bir-parola-yaz@localhost:5432/pts

# --- API ---
PTS_BIND_ADDR=0.0.0.0:8080

# Ayni ArUco markerin tekrar okunmasini yok sayma suresi (saniye)
PTS_SCAN_DEBOUNCE_SECONDS=30

# Tarayiciya izin verilen origin. Uretimde frontend ile API ayni alan adinda
# oldugu icin bos birakilabilir; bos ise CORS basligi hic gonderilmez.
# Gelistirmede Vite proxy kullanildigindan yine gerekmez.
PTS_ALLOWED_ORIGIN=

# --- Oturum ---
# JWT imzalama anahtari; en az 16 karakter. Degistirilirse acik oturumlar duser.
# Uretmek icin: openssl rand -base64 48
PTS_JWT_SECRET=degistir-bu-anahtari-en-az-16-karakter

# Hic kullanici yokken olusturulacak ilk yonetici. Hesap olustuktan sonra bu
# degerler yok sayilir; parolayi panelden degil, su an buradan belirlersiniz.
PTS_ADMIN_USERNAME=admin
PTS_ADMIN_PASSWORD=

# Kioskun cihaz anahtari olmadan kayit acabilmesi. Yalnizca gelistirme icin;
# sahada 0 birakin, aksi halde adresi bilen herkes gecis olusturabilir.
PTS_ALLOW_ANONYMOUS_KIOSK=0

# Giris deneme siniri: bu kadar hatali denemeden sonra hesap kilitlenir.
PTS_LOGIN_MAX_ATTEMPTS=3
PTS_LOGIN_LOCK_MINUTES=15

# Gecis fotograflarinin yazildigi dizin. Docker'da pts-photos birimine bagli.
PTS_PHOTO_DIR=/data/photos

RUST_LOG=info,sqlx=warn
